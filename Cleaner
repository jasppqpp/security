async def moderate_message(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not chat:
        return

    if chat.type not in (
        ChatType.GROUP,
        ChatType.SUPERGROUP,
    ):
        return

    if not user or user.is_bot:
        return

    # مهم:
    # التوب يحسب كل الرسائل.
    # سجل التنظيف يستقبل الأنواع المحددة فقط.
    member = await track_message(update, context)

    # الكتم مستقل عن إعدادات الحذف العامة: رسائل المكتوم تُحذف دائماً.
    moderation = active_moderation(chat.id, user.id)
    if moderation and moderation["kind"] == "mute":
        await safe_delete(chat.id, message.message_id, context)
        return

    # معالجات الأوامر تعمل في مجموعة handlers سابقة؛ لا تعالج الأمر مرة ثانية
    # كرسالة عادية، وخصوصاً أوامر الكتم التي تُرسل رداً على رسالة عضو.
    if message.text:
        command_text = message.text.strip()
        if (
            command_text.startswith("/")
            or parse_moderation_command(command_text) is not None
            or command_text in {
                "إعدادات الكتم", "اعدادات الكتم",
                "إعدادات التقييد", "اعدادات التقييد",
                "تنظيف", "حالة", "توب", "توب المشرفين",
                "تصفير توب المشرفين", "تصفير التوب",
                "تصفير توب المتفاعلين", "تفعيل", "/تفعيل",
                "إيقاف", "/إيقاف",
            }
        ):
            return

    if setting("enabled", "1") != "1":
        return

    group = get_group(chat.id)

    if not group or not group.get("enabled", 1):
        return

    # السماح لآيديات البوت الأساسية ومالك الكروب بالرد.
    # بقية الأعضاء والمشرفين لا يُسمح لهم بالرد على رسائل الآخرين.
    is_group_owner = (
        member is not None
        and member.status == ChatMemberStatus.OWNER
    )
    
    if (
        group.get("replies_enabled", 1)
        and message.reply_to_message
        and message.reply_to_message.from_user
        and message.reply_to_message.from_user.id != user.id
        and user.id not in DEFAULT_ADMINS
        and not is_group_owner
    ):
        delete_text = (
            group.get("delete_message")
            or "ممنوع إرسال الردود"
        )

        if delete_text == "ممنوع إرسال الردود":
            with db() as con:
                row = con.execute("""
                    SELECT delete_message
                    FROM groups
                    WHERE chat_id=0
                """).fetchone()

            if row and row["delete_message"]:
                delete_text = row["delete_message"]

        if await safe_delete(
            chat.id,
            message.message_id,
            context,
        ):
            try:
                await context.bot.send_message(
                    chat.id,
                    f"{user.mention_html()} "
                    f"{html.escape(delete_text)}",
                    parse_mode="HTML",
                )
            except TelegramError:
                pass

        return

    # استثناء مشرفي الكروب من بقية أنواع الحذف والاشتراك الإجباري.
    # هذا الاستثناء يأتي بعد فحص الردود حتى تُطبّق عليهم قاعدة منع الردود.
    if member and member.status in (
        ChatMemberStatus.ADMINISTRATOR,
        ChatMemberStatus.OWNER,
    ):
        return

    if await subscription_gate(update, context, group):
        return

    text = message.text or message.caption or ""
    delete = False

    if group.get("delete_links") and message_has_link(message):
        delete = True

    if group.get("delete_photos") and message.photo:
        delete = True

    if group.get("delete_videos") and (
        message.video or message.video_note
    ):
        delete = True

    if group.get("delete_stickers") and message.sticker:
        delete = True

    if group.get("delete_gifs") and message.animation:
        delete = True

    if group.get("delete_audio") and (
        message.audio or message.voice
    ):
        delete = True

    if group.get("delete_files") and message.document:
        delete = True

    if group.get("delete_forwarded") and (
        getattr(message, "forward_origin", None)
        or getattr(message, "forward_date", None)
    ):
        delete = True


    if delete:
        await safe_delete(
            chat.id,
            message.message_id,
            context,
        )
        return

    # الردود العامة أو الخاصة بالكروب.
    if message.text:
        with db() as con:
            reply = con.execute("""
                SELECT response
                FROM auto_replies
                WHERE keyword=? AND chat_id IN (0,?)
                ORDER BY chat_id DESC
                LIMIT 1
            """, (
                message.text.strip(),
                chat.id,
            )).fetchone()

        if reply:
            try:
                await message.reply_text(reply["response"])
            except TelegramError:
                pass


async def admin_top_command(update, context):
    chat = update.effective_chat
    message = update.effective_message

    if not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await message.reply_text("هذا الأمر مخصص للكروبات.")
        return

    if not await is_group_admin(update, context):
        await message.reply_text("هذا الأمر مخصص لمشرفي الكروب فقط.")
        return

    try:
        administrators = await context.bot.get_chat_administrators(chat.id)
        admins = [item.user for item in administrators if not item.user.is_bot]

        if not admins:
            await message.reply_text("لا يوجد مشرفون لعرض التوب.")
            return

        with db() as con:
            rows = con.execute(
                "SELECT user_id,name,messages FROM admin_messages WHERE chat_id=?",
                (chat.id,),
            ).fetchall()

        saved = {row["user_id"]: row for row in rows}
        results = []
        for admin in admins:
            row = saved.get(admin.id)
            results.append((
                row["name"] if row and row["name"] else admin.full_name,
                row["messages"] if row else 0,
            ))

        results.sort(key=lambda item: item[1], reverse=True)
        lines = ["🏆 <b>توب مشرفي الكروب</b>", f"👥 عدد المشرفين: {len(admins)}", ""]
        for rank, (name, count) in enumerate(results, 1):
            lines.append(f"{rank}. {html.escape(name or 'مشرف')} — {count} رسالة")

        await message.reply_text("\n".join(lines), parse_mode="HTML")
    except TelegramError as exc:
        log.warning("تعذر جلب مشرفي الكروب %s: %s", chat.id, exc)
        await message.reply_text("تعذر جلب قائمة المشرفين. تأكد من صلاحيات البوت.")


async def reset_admin_top(update, context):
