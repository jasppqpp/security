        return

    await context.bot.send_chat_action(chat_id=chat.id, action="typing")
    history = context.user_data.get("ai_history", [])[-10:]
    conversation = history + [{"role": "user", "content": prompt}]
    admin_context = ai_admin_context()

    try:
        client = context.bot_data.get("openai_client")
        if client is None:
            client = AsyncOpenAI(api_key=OPENAI_API_KEY, timeout=30.0, max_retries=1)
            context.bot_data["openai_client"] = client
        response = await client.responses.create(
            model=OPENAI_MODEL,
            instructions=(
                AI_SYSTEM_PROMPT + "\n\nبيانات Cleaner الحالية (مصدر الحقيقة):\n" + admin_context
            ),
            input=conversation,
            max_output_tokens=700,
        )
        answer = (response.output_text or "ما قدرت أجهز إجابة حالياً.").strip()
        record_ai_request(user.id, today)
        context.user_data["ai_history"] = (
            conversation + [{"role": "assistant", "content": answer}]
        )[-12:]
        context.user_data["ai_mode"] = True
        # Telegram messages have a 4096-character limit; split long answers safely.
        for start in range(0, len(answer), 3900):
            await message.reply_text(answer[start:start + 3900])
    except Exception as exc:
        # Avoid logging raw provider exceptions that could contain request metadata.
        log.error("AI assistant request failed (%s)", type(exc).__name__)
        await message.reply_text(
            "تعذر الاتصال بخدمة الذكاء الاصطناعي حالياً. تحقق من إعداد المفتاح والرصيد/حدود الاستخدام، ثم حاول لاحقاً."
        )


