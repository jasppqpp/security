async def group_text_commands(update, context):
    message = update.effective_message
    chat = update.effective_chat

    if (
        not message
        or not message.text
        or not chat
        or chat.type == ChatType.PRIVATE
    ):
        return

    text = message.text.strip()

    parsed_moderation = parse_moderation_command(text)
    if parsed_moderation:
        await moderation_command(update, context, parsed_moderation)
        return

    if text in ("إعدادات الكتم", "اعدادات الكتم", "إعدادات التقييد", "اعدادات التقييد"):
        if not await is_group_admin(update, context):
            await message.reply_text("هذه الإعدادات للمشرفين فقط.")
            return
        await show_moderation_help(message)
        return

    if text == "تنظيف":
        await clean_24h(update, context)

    elif text == "حالة":
        await message.reply_text(
            cleaner_status(chat.id),
            parse_mode="HTML",
        )

    elif text == "توب":
        if not await is_group_admin(update, context):
            await message.reply_text("هذا الأمر مخصص لمشرفي الكروب فقط.")
            return

        await show_top(
            chat.id,
            context,
            message,
        )

    elif text == "توب المشرفين":
        await admin_top_command(update, context)

    elif text == "تصفير توب المشرفين":
        await reset_admin_top(update, context)

    elif text in (
        "تصفير التوب",
        "تصفير توب المتفاعلين",
    ):
        await reset_top(update, context)

    elif text in ("تفعيل", "/تفعيل"):
        if not await is_group_admin(update, context):
            await message.reply_text("هذا الأمر للمشرفين فقط.")
            return

        update_group(chat.id, "enabled", 1)
        update_group(chat.id, "replies_enabled", 1)

        await message.reply_text(
            "✅ تم تفعيل البوت وحذف الردود في هذا الكروب."
        )

    elif text in ("إيقاف", "/إيقاف"):
        if not await is_group_admin(update, context):
            await message.reply_text("هذا الأمر للمشرفين فقط.")
            return

        update_group(chat.id, "replies_enabled", 0)

        await message.reply_text(
            "⏸ تم إيقاف حذف الردود في هذا الكروب."
        )


