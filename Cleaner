def create_database_backup():
    """Create an atomic SQLite backup; retain only the five newest snapshots."""
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    destination = BACKUP_DIR / f"cleaner_backup_{stamp}.db"
    source = sqlite3.connect(DB_PATH, timeout=30)
    target = sqlite3.connect(str(destination), timeout=30)
    try:
        source.backup(target)
        target.commit()
    finally:
        target.close()
        source.close()
    try:
        destination.chmod(0o600)
    except OSError:
        pass
    backups = sorted(BACKUP_DIR.glob("cleaner_backup_*.db"), key=lambda p: p.stat().st_mtime, reverse=True)
    for old in backups[5:]:
        try:
            old.unlink()
        except OSError:
            log.warning("تعذر حذف نسخة احتياطية قديمة")
    return destination


