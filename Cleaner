            result["integrity"] = con.execute("PRAGMA integrity_check").fetchone()[0]
            result["groups"] = con.execute("SELECT COUNT(*) FROM groups WHERE chat_id<>0").fetchone()[0]
            result["admins"] = con.execute("SELECT COUNT(*) FROM bot_admins").fetchone()[0]
