async def clean_command(update, context):
    await clean_24h(update, context)


async def top_command(update, context):
    chat = update.effective_chat
    message = update.effective_message

    if chat and chat.type in (
        ChatType.GROUP,
        ChatType.SUPERGROUP,
    ):
        if not await is_group_admin(update, context):
            await message.reply_text("هذا الأمر مخصص لمشرفي الكروب فقط.")
            return

        await show_top(
            chat.id,
            context,
            message,
        )


async def status_command(update, context):
    chat = update.effective_chat
    message = update.effective_message

    if chat and chat.type in (
        ChatType.GROUP,
        ChatType.SUPERGROUP,
    ):
        await message.reply_text(
            cleaner_status(chat.id),
            parse_mode="HTML",
        )
    elif chat and chat.type == ChatType.PRIVATE:
        if not update.effective_user or not is_bot_admin(update.effective_user.id):
            await message.reply_text("هذه الإحصائيات لمشرفي البوت المعتمدين فقط.")
            return
        await message.reply_text(stats_text(), parse_mode="HTML")


async def enable_command(update, context):
    chat = update.effective_chat
    message = update.effective_message

    if await is_group_admin(update, context) and chat:
        update_group(chat.id, "enabled", 1)
        update_group(chat.id, "replies_enabled", 1)

        await message.reply_text("✅ تم التفعيل.")


async def disable_command(update, context):
    chat = update.effective_chat
    message = update.effective_message

    if await is_group_admin(update, context) and chat:
        update_group(chat.id, "replies_enabled", 0)

        await message.reply_text(
            "⏸ تم إيقاف حذف الردود."
        )


async def post_init(application):
    """Publish a compact Telegram command menu for the bot."""
    commands = [
        BotCommand("start", "فتح لوحة Cleaner"),
        BotCommand("help", "دليل الاستخدام"),
        BotCommand("status", "حالة البوت"),
        BotCommand("ai", "المساعد الإداري الذكي"),
        BotCommand("ai_stop", "إيقاف المساعد"),
        BotCommand("ai_reset", "مسح سياق المساعد"),
        BotCommand("health", "فحص سلامة النظام"),
        BotCommand("audit", "سجل النشاط الإداري"),
        BotCommand("backup", "نسخة احتياطية للمالك"),
    ]
    try:
        await application.bot.set_my_commands(commands)
    except TelegramError as exc:
        log.warning("تعذر تحديث قائمة أوامر تيليجرام (%s)", type(exc).__name__)


async def error_handler(update, context):
    error = context.error
    log.error(
        "Update processing failed (%s). Check configuration and permissions.",
        type(error).__name__ if error else "UnknownError",
    )


# =========================================================
# التشغيل
# =========================================================

def main():
    if not TOKEN:
        raise RuntimeError(
            "عيّن توكن البوت في متغير البيئة BOT_TOKEN."
        )

    init_db()
    try:
        Path(DB_PATH).chmod(0o600)
    except OSError:
        pass

    app = (
        Application.builder()
        .token(TOKEN)
        .post_init(post_init)
        .concurrent_updates(False)
        .build()
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("clean", clean_command))
    app.add_handler(CommandHandler("top", top_command))
    app.add_handler(CommandHandler("status", status_command))
    app.add_handler(CommandHandler("enable", enable_command))
    app.add_handler(CommandHandler("disable", disable_command))
    app.add_handler(CommandHandler("reset_top", reset_top))
    app.add_handler(CommandHandler("admin_top", admin_top_command))
    app.add_handler(CommandHandler("reset_admin_top", reset_admin_top))
    app.add_handler(CommandHandler("ai", ai_command))
    app.add_handler(CommandHandler("ai_stop", ai_stop_command))
    app.add_handler(CommandHandler("ai_reset", ai_reset_command))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(CommandHandler("health", health_command))
    app.add_handler(CommandHandler("audit", audit_command))
    app.add_handler(CommandHandler("backup", backup_command))

    app.add_handler(
        CallbackQueryHandler(panel_callback)
    )

    # رسائل المساعد الإداري في الخاص (للمشرفين المعتمدين فقط).
    app.add_handler(
        MessageHandler(
            filters.ChatType.PRIVATE
            & filters.TEXT
            & ~filters.COMMAND,
            ai_private_message,
        ),
        group=-1,
    )

    # إجابات لوحة التحكم في الخاص.
    app.add_handler(
        MessageHandler(
            filters.ChatType.PRIVATE
            & filters.TEXT
            & ~filters.COMMAND,
            private_pending,
        ),
        group=0,
    )

    # أوامر النصوص في الكروبات.
    app.add_handler(
        MessageHandler(
            filters.ChatType.GROUPS & filters.TEXT,
            group_text_commands,
        ),
        group=1,
    )

    # معالجة جميع الرسائل، بما فيها الميديا.
    # هذا المعالج منفصل عن معالج الأوامر أعلاه.
    app.add_handler(
        MessageHandler(
            filters.ChatType.GROUPS
            & ~filters.StatusUpdate.ALL,
            moderate_message,
        ),
        group=2,
    )

    app.add_error_handler(error_handler)

    # تنظيف سجلات الكتم/التقييد المنتهية دورياً.
    if app.job_queue:
        app.job_queue.run_repeating(
            expire_moderations, interval=15, first=5,
            name="expire_moderations",
        )
        app.job_queue.run_repeating(
            prune_tracking_job, interval=6 * 60 * 60, first=60,
            name="prune_tracking_rows",
        )

    log.info("Cleaner Pro started. Database: %s", Path(DB_PATH).name)

    app.run_polling(
        allowed_updates=Update.ALL_TYPES,
        drop_pending_updates=False,
        bootstrap_retries=5,
    )


if __name__ == "__main__":
    main()
 
